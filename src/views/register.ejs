<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/css/general.css" />
  <link rel="stylesheet" href="/css/auth.css" />
  <script src="/js/auth.js" defer></script>
  <title>Crear cuenta | TellmeWhere</title>
</head>

<body>
  <%- include('partials/header') %>

  <main class="auth">
    <!-- PANEL DE IMAGEN -->
    <section class="auth-visual auth-visual-registro" aria-hidden="true">
      <div class="auth-visual-contenido">
        <span class="auth-lugar">📍 Marrakech, Marruecos</span>
        <p class="auth-frase">Únete y viaja<br><span>más por menos</span>.</p>
        <ul class="auth-ventajas">
          <li>Registro gratis en un minuto</li>
          <li>Puntos de bienvenida para tu primer viaje</li>
          <li>Avisos de ofertas antes que nadie</li>
        </ul>
      </div>
    </section>

    <!-- PANEL DEL FORMULARIO -->
    <section class="auth-panel">
      <div class="auth-tarjeta">
        <nav class="auth-pestanas" aria-label="Cuenta">
          <a href="/login">Iniciar sesión</a>
          <a href="/register" class="activa" aria-current="page">Crear cuenta</a>
        </nav>

        <h1>Crea tu cuenta ✈</h1>
        <p class="auth-intro">Solo te pedimos lo necesario para tus reservas.</p>

        <% if (mensaje) { %>
          <p class="auth-mensaje error" role="status"><%= mensaje %></p>
        <% } %>

        <form method="post" action="/register" class="auth-form auth-form-2col">
          <div class="auth-campo">
            <label for="name">Nombre</label>
            <div class="auth-entrada">
              <%- include('partials/auth-iconos', { icono: 'persona' }) %>
              <input type="text" id="name" name="name" autocomplete="given-name" placeholder="Lucía" required />
            </div>
          </div>
          <div class="auth-campo">
            <label for="surname">Apellidos</label>
            <div class="auth-entrada">
              <%- include('partials/auth-iconos', { icono: 'persona' }) %>
              <input type="text" id="surname" name="surname" autocomplete="family-name" placeholder="García López" required />
            </div>
          </div>
          <div class="auth-campo auth-campo-completo">
            <label for="email">Email</label>
            <div class="auth-entrada">
              <%- include('partials/auth-iconos', { icono: 'email' }) %>
              <input type="email" id="email" name="email" autocomplete="email" placeholder="tu@email.com" required />
            </div>
          </div>
          <div class="auth-campo auth-campo-completo">
            <label for="tel">Teléfono</label>
            <div class="auth-telefono">
              <select id="pre" name="prefijo" aria-label="Prefijo del país">
                <option value="+34">ES +34</option>
                <option value="+351">PT +351</option>
                <option value="+33">FR +33</option>
                <option value="+39">IT +39</option>
                <option value="+44">UK +44</option>
                <option value="+49">DE +49</option>
              </select>
              <div class="auth-entrada auth-entrada-sin-icono">
                <input type="tel" id="tel" name="tel" autocomplete="tel-national" inputmode="tel" placeholder="600 000 000" required />
              </div>
            </div>
          </div>
          <div class="auth-campo">
            <label for="password">Contraseña</label>
            <div class="auth-entrada">
              <%- include('partials/auth-iconos', { icono: 'candado' }) %>
              <input type="password" id="password" name="password" autocomplete="new-password" minlength="6" placeholder="Mínimo 6 caracteres" required aria-describedby="fuerza-texto" />
              <button type="button" class="auth-ver" data-ver="password" aria-label="Mostrar contraseña">Ver</button>
            </div>
            <div class="auth-fuerza" data-nivel="0" aria-hidden="true"><span></span><span></span><span></span></div>
            <small id="fuerza-texto" class="auth-fuerza-texto">Usa letras, números y algún símbolo</small>
          </div>
          <div class="auth-campo">
            <label for="nationality">Nacionalidad</label>
            <div class="auth-entrada">
              <%- include('partials/auth-iconos', { icono: 'bandera' }) %>
              <input type="text" id="nationality" name="nationality" autocomplete="country-name" placeholder="España" required />
            </div>
          </div>
          <label class="auth-check auth-campo-completo" for="novedades">
            <input type="checkbox" id="novedades" name="novedades" required />
            <span>Acepto los términos y condiciones y la política de privacidad</span>
          </label>
          <button type="submit" id="send" class="auth-boton auth-campo-completo">Crear cuenta <span aria-hidden="true">→</span></button>
        </form>

        <p class="auth-pie">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>

</html>
