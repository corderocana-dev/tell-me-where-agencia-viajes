<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="../css/home.css">
    <link rel="stylesheet" href="../css/general.css">
    <script type="text/javascript" src="../js/home.js"></script>
    <title>TellmeWhere-Home</title>
</head>

<body>
    <%- include('partials/header') %>
    <!-- PORTADA (HERO) -->
    <header class="hero">
        <img class="hero-foto" src="/img/hero-1920.jpg" alt="Viajera subiendo la pirámide de Chichén Itzá" fetchpriority="high">

        <div class="hero-contenido">
            <!-- Avión que cruza la portada justo por encima de la etiqueta (detalle decorativo) -->
            <div class="hero-avion" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg>
            </div>
            <p class="hero-etiqueta">✈ Agencia de viajes online</p>
            <h1>Descubre tu próximo <span>destino</span></h1>
            <p class="hero-subtitulo">Paquetes de vuelo y hotel a los destinos más buscados, al mejor precio.</p>

            <!-- BUSCADOR: lleva a Paquetes con el destino y las fechas elegidas -->
            <form class="hero-buscador" action="/list" method="get">
                <div class="hero-campo hero-campo-destino">
                    <label for="hero-destino">Destino</label>
                    <select id="hero-destino" name="destino" required>
                        <option value="" disabled selected>¿A dónde quieres ir?</option>
                        <optgroup label="España">
                            <option value="barcelona">Barcelona</option>
                        </optgroup>
                        <optgroup label="Europa">
                            <option value="praga">Praga</option>
                            <option value="budapest">Budapest</option>
                            <option value="roma">Roma</option>
                        </optgroup>
                        <optgroup label="Asia">
                            <option value="tokio">Tokio</option>
                        </optgroup>
                        <optgroup label="África">
                            <option value="marrakech">Marrakech</option>
                        </optgroup>
                    </select>
                </div>
                <div class="hero-campo">
                    <label for="hero-ida">Ida</label>
                    <input type="date" id="hero-ida" name="ida">
                </div>
                <div class="hero-campo">
                    <label for="hero-vuelta">Vuelta</label>
                    <input type="date" id="hero-vuelta" name="vuelta">
                </div>
                <div class="hero-campo">
                    <label for="hero-viajeros">Viajeros</label>
                    <select id="hero-viajeros" name="viajeros">
                        <option value="1adult">1 adulto</option>
                        <option value="2adult" selected>2 adultos</option>
                        <option value="1adult_child">1 adulto, 1 niño/a</option>
                        <option value="2adults_child">2 adultos, 1 niño/a</option>
                        <option value="2adults_2childrens">2 adultos, 2 niños/as</option>
                    </select>
                </div>
                <button type="submit" class="hero-boton">Buscar viaje</button>
            </form>

            <ul class="hero-ventajas">
                <li>Mejor precio</li>
                <li>Pago seguro</li>
                <li>Atención 24/7</li>
            </ul>
        </div>

        <!-- OFERTA DESTACADA (sustituye a la ventana flotante con cuenta atrás) -->
        <a class="hero-oferta" href="/product">
            <img src="/img/pragacabecera.jpg" alt="">
            <span class="hero-oferta-texto">
                <span class="hero-oferta-etiqueta">Oferta destacada</span>
                <strong>Praga · 2 noches</strong>
                <span>desde <b>322€</b> por persona</span>
            </span>
            <span class="hero-oferta-flecha" aria-hidden="true">→</span>
        </a>
    </header>

    <!--SALES-->

    <main>

        <p class="bluetitle">Ofertas seleccionadas</p>
        <section>
            <div id="circles">
                <div class="circle">
                    <img src="/img/italia.jpg" alt="Italia">
                    <div class="colorcircle">
                        <p class="circletitle">ITALIA</p>
                        <p class="circlesize">3 noches hotel <span class="orange">*****</span></p>
                        <p>desde <span class="orangeb">365€</span></p>
                    </div>
                </div>
                <div class="circle">
                    <img src="/img/grecia.jpg" alt="Grecia">
                    <div class="colorcircle">
                        <p class="circletitle">GRECIA</p>
                        <p class="circlesize">3 noches hotel <span class="orange">*****</span></p>
                        <p>desde <span class="orangeb">365€</span></p>
                    </div>
                </div>
                <div class="circle">
                    <img src="/img/marruecos.png" alt="Marruecos">
                    <div class="colorcircle">
                        <p class="circletitle">MARRUECOS</p>
                        <p class="circlesize">3 noches hotel <span class="orange">*****</span></p>
                        <p>desde <span class="orangeb">365€</span></p>
                    </div>
                </div>
                <div class="circle">
                    <img src="/img/espana.jpg" alt="España">
                    <div class="colorcircle">
                        <p class="circletitle">ESPAÑA</p>
                        <p class="circlesize">3 noches hotel <span class="orange">*****</span></p>
                        <p>desde <span class="orangeb">365€</span></p>
                    </div>
                </div>
                <div class="circle">
                    <img src="/img/alemania.jpg" alt="Alemania">
                    <div class="colorcircle">
                        <p class="circletitle">ALEMANIA</p>
                        <p class="circlesize">3 noches hotel <span class="orange">*****</span></p>
                        <p>desde <span class="orangeb">365€</span></p>
                    </div>
                </div>
                <div class="circle">
                    <img src="/img/japon.jpg" alt="Japón">
                    <div class="colorcircle">
                        <p class="circletitle">JAPÓN</p>
                        <p class="circlesize">3 noches hotel <span class="orange">*****</span></p>
                        <p>desde <span class="orangeb">365€</span></p>
                    </div>
                </div>
            </div>

            <!--CAROUSEL MOST SEARCHED-->

            <p class="bluetitle">Los más buscados</p>

            <section class="slider-wrapper">
                <button class="slide-arrow" id="slide-arrow-prev">
                    &#8249;
                </button>
                <button class="slide-arrow" id="slide-arrow-next">
                    &#8250;
                </button>
                <ul class="slides-container" id="slides-container">
                    <li class="slide">
                        <div class="carousel-textBox">
                            <p>ITALIA</p>
                        </div>
                    </li>
                    <li class="slide">
                        <div class="carousel-textBox">
                            <p>PRAGA</p>
                        </div>
                    </li>
                    <li class="slide">
                        <div class="carousel-textBox">
                            <p>MARRUECOS</p>
                        </div>
                    </li>
                    <li class="slide">
                        <div class="carousel-textBox">
                            <p>JAPÓN</p>
                        </div>
                    </li>
                </ul>
            </section>

            <!--BENEFITS-->

            <p class="bluetitle">Beneficios TellmeWhere</p>
            <section>
                <div id="benefits">
                    <div class="benefit">
                        <img
                            src="data:image/png;base64,">
                        <p class="benefittitle">Ofertas seleccionadas</p>
                        <p class="benefitgray">Te encontramos las mejores ofertas con la mejor relación calidad-precio.
                        </p>
                    </div>
                    <div class="benefit">
                        <img src="https://img.icons8.com/wired/64/edison-bulb.png" alt="edison-bulb" />
                        <p class="benefittitle">Asesoramiento personalizado</p>
                        <p class="benefitgray">Estamos a tu disposición en las Redes Sociales.</p>
                    </div>
                    <div class="benefit">
                        <img
                            src="data:image/png;base64,">
                        <p class="benefittitle">Reserva fácil y segura</p>
                        <p class="benefitgray">Encuentra con nosotros tus próximas vacaciones de manera fácil y segura.
                        </p>
                    </div>
                    <div class="benefit">
                        <img
                            src="data:image/png;base64,">
                        <p class="benefittitle">Inspiración solo para ti</p>
                        <p class="benefitgray">Nuestro equipo editorial te brindará consejos y te ayudará a planificar
                            tu
                            viaje.</p>
                    </div>
                </div>
            </section>

            <!--ABOUT US-->

            <p class="bluetitle">Sobre nosotros</p>
            <section id="sectionsono">
                <div id="divsono">
                    <p class="description">
                        En TellMeWhere, nuestra pasión es hacer que cada viaje sea una
                        experiencia inolvidable. Fundada en el espíritu de la aventura y la
                        exploración, nos enorgullece ofrecer a nuestros clientes una gama
                        diversa de destinos y servicios turísticos de alta calidad. Desde
                        nuestra fundación, nos hemos comprometido a proporcionar
                        experiencias de viaje excepcionales que superen las expectativas de
                        nuestros clientes. Ya sea que estés planeando unas vacaciones
                        relajantes en una playa paradisíaca, una emocionante escapada de
                        aventura o un viaje cultural lleno de descubrimientos, nuestro
                        equipo de expertos está aquí para hacer realidad tus sueños de
                        viaje.
                    </p>
                    <div id="sonocomments">
                        <textarea class="comentary" name="" id="comentario" cols="30" rows="10"
                            placeholder="Escribe tu comentario..."></textarea>
                        <div id="sonoopinion">
                            <p class="opinion">Excelente</p>
                            <div class="stars">
                                <div class="rating">
                                    <span data-rating="5">★</span>
                                    <span data-rating="4">★</span>
                                    <span data-rating="3">★</span>
                                    <span data-rating="2">★</span>
                                    <span data-rating="1">★</span>
                                </div>
                            </div>
                            <p>En base a <span class="underline">140 opiniones</span></p>
                            <input class="button" type="submit" id="send" name="send" value="Enviar" />
                            <div id="popup" class="popup">Comentario enviado</div>
                        </div>
                    </div>


                </div>
                <div id="divimg">
                    <img src="/img/GrandVoyage-Cuba-Barco-Playa.jpg" alt="" />
                </div>
            </section>

            <!--SOCIAL COMMENTS-->

            <section id="social">
                <div class="completeUser">
                    <div>
                        <div class="user">
                            <div class="userName">
                                <p class="letterUser L">L</p>
                                <p>Laura</p>
                            </div>
                            <div class="stars">
                                <img src="/img/stars.png" alt="stars">
                            </div>
                        </div>
                        <div>
                            <p>"Check in rápido y eficaz. En recepción gente joven y muy amable en espera de ayudarte en
                                lo
                                que
                                necesites durante tu estadía."
                            </p>
                        </div>
                        <div class="more">
                            <p>Más...</p>
                        </div>
                    </div>
                    <div>

                    </div>
                </div>
                <div class="completeUser">
                    <div>
                        <div class="user">
                            <div class="userName">
                                <p class="letterUser R">R</p>
                                <p>Rubén</p>
                            </div>
                            <div class="stars">
                                <img src="/img/stars.png" alt="stars">
                            </div>
                        </div>
                        <div>
                            <p>"Check in rápido y eficaz. En recepción gente joven y muy amable en espera de ayudarte en
                                lo
                                que
                                necesites durante tu estadía."
                            </p>
                        </div>
                        <div class="more">
                            <p>Más...</p>
                        </div>
                    </div>

                </div>
                <div class="completeUser">
                    <div>
                        <div class="user">
                            <div class="userName">
                                <p class="letterUser A">A</p>
                                <p>Aless</p>
                            </div>
                            <div class="stars">
                                <img src="/img/stars.png" alt="stars">
                            </div>
                        </div>
                        <div>
                            <p>"Check in rápido y eficaz. En recepción gente joven y muy amable en espera de ayudarte en
                                lo
                                que
                                necesites durante tu estadía."
                            </p>
                        </div>
                        <div class="more">
                            <p>Más...</p>
                        </div>
                    </div>

                </div>
            </section>
    </main>

    <!--FOOTER-->

    <%- include('partials/footer') %>
</body>

</html>